{
  "compilerOptions": {
    /* 后端与前端共用 TypeScript，但编译目标不同：前端由 Vite/esbuild 打包，
       后端编译成 CommonJS 供 Node 直接运行。 */
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "server-dist",
    "rootDir": "server",
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* 刻意留空：根 tsconfig.json 说明了本项目不安装 @types/node，以免浏览器代码
       误用 Node 全局。后端需要的极少数 Node API 由 server/src/node-shims.d.ts 本地声明。 */
    "types": []
  },
  "include": ["server/src/**/*.ts", "server/tests/**/*.ts"]
}
