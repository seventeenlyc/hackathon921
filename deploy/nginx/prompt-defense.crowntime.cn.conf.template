# prompt-defense.crowntime.cn —— 静态前端站点
#
# 这是一个模板：__SSL_CERT__ / __SSL_KEY__ 由 deploy/bootstrap-server.sh 在安装时替换。
# 证书路径不写进仓库，因为它指向本机上另一个无关应用的内部目录，属于
# docs/PRODUCT_CONCEPT.md §14 所说的「不在本仓库记录」的运维细节。
#
# 本文件只新增，不修改目标机上任何既有站点的配置。

# 排行榜 API 限流（docs/PRODUCT_CONCEPT.md §14 要求的「反向代理限流」）。
# limit_req_zone 必须位于 http 上下文，而 conf.d/*.conf 正是被 include 进 http，故写在此处。
limit_req_zone $binary_remote_addr zone=pd_api:10m rate=10r/s;

server {
    server_name prompt-defense.crowntime.cn;

    # current 是指向 releases/<commit-sha>/ 的符号链接。
    # nginx 在每次请求时才解析 root 下的符号链接，所以切换版本无需 reload，
    # 部署用户因此完全不需要 sudo。
    root /srv/apps/prompt-defense.crowntime.cn/current;
    index index.html;

    # index.html 必须不缓存。构建产物带内容 hash 可以长缓存，但 HTML 不行：
    # 原子切换版本后若浏览器仍用旧 HTML，它引用的旧 hash 资源已被清理，页面直接白屏。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # 部署校验用，内容是当前线上版本的 commit sha，同样不可缓存。
    location = /version.txt {
        add_header Cache-Control "no-cache, must-revalidate" always;
        default_type text/plain;
    }

    # 排行榜后端：systemd 以独立系统用户运行在 127.0.0.1:8781（deploy/README.md §5）。
    location /api/ {
        limit_req zone=pd_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8781;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # 后端编译产物位于 current/server/，但它是服务端代码，不是公开静态资源。
    location ^~ /server/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name prompt-defense.crowntime.cn;
    return 301 https://$host$request_uri;
}
